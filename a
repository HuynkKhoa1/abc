local function isValidEntity(npc, myName, hrpPos, tagOwnerStr)
    if not npc:IsA("Model") then return false end
    local name = npc.Name

    local rule = getEntityRule(name)
    if rule and rule.heavy then return false end

    local npcHrp = npc:FindFirstChild("HumanoidRootPart")
        or npc:FindFirstChild("Torso")
        or npc.PrimaryPart
    if not npcHrp then return false end

    local dist = (npcHrp.Position - hrpPos).Magnitude
    if dist > CONFIG.AGGRO_RANGE then return false end

    local state = npc:GetAttribute("CurrentState")
    if state == "Unconscious" then return false end

    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end

    local isShinigami = name:match("^Shinigami_") ~= nil
    local pref        = npc:GetAttribute("PreferredTargets")
    local targetsMe   = pref and tostring(pref):find(myName, 1, true) ~= nil
    local isTagger    = tagOwnerStr and tagOwnerStr == name

    if isShinigami or targetsMe or (isTagger and rule and rule.attack) then
        return true, npcHrp, dist, rule
    end
    return false
end

local function scanTargets()
    local entFolder = Workspace:FindFirstChild("Entities")
    if not entFolder then return {} end
    local char, hrp = getChar()
    if not hrp then return {} end

    local myName     = player.Name
    local tagOwnerStr = char and tostring(char:GetAttribute("CombatTagOwner") or "")
    if tagOwnerStr == "" then tagOwnerStr = nil end

    local list = {}
    for _, npc in ipairs(entFolder:GetChildren()) do
        local ok, npcHrp, dist, rule = isValidEntity(npc, myName, hrp.Position, tagOwnerStr)
        if ok then
            table.insert(list, { npc = npc, hrp = npcHrp, dist = dist, rule = rule })
        end
    end
    table.sort(list, function(a, b)
        local aT = (a.rule and a.rule.kind ~= "shinigami") and 0 or 1
        local bT = (b.rule and b.rule.kind ~= "shinigami") and 0 or 1
        if aT ~= bT then return aT < bT end
        return a.dist < b.dist
    end)
    return list
end

local function findGripTarget()
