local function findNearestBoard()
    local f = Workspace:FindFirstChild("NPCs") and Workspace.NPCs:FindFirstChild("MissionNPC")
    if not f then return nil, "MissionNPC folder not found" end
    local _, hrp = getChar()
    if not hrp then return nil, "Character not ready" end

    local best, bestD = nil, math.huge
    for _, npc in ipairs(f:GetChildren()) do
        local board = npc:FindFirstChild("Board")
        local union = board and board:FindFirstChild("Union")
        local cd    = union and union:FindFirstChildOfClass("ClickDetector")
        if cd and union:IsA("BasePart") then
            local d = (union.Position - hrp.Position).Magnitude
            if d < bestD then bestD, best = d, { npc = npc, part = union, cd = cd, dist = d } end
        end
    end
    if not best then return nil, "No board found" end
    return best
end

local activeFlight = nil
local function stopFlight()
    if activeFlight then
        if activeFlight.conn then activeFlight.conn:Disconnect() end
        if activeFlight.bv and activeFlight.bv.Parent then activeFlight.bv:Destroy() end
        if activeFlight.bg and activeFlight.bg.Parent then activeFlight.bg:Destroy() end
        if activeFlight.hum then
            pcall(function()
                activeFlight.hum.PlatformStand = false
                activeFlight.hum.AutoRotate    = true
            end)
        end
        activeFlight = nil
    end
end

local function setupFlight()
    local _, hrp, hum = waitChar()
    if not hrp then return nil end
    if hum then
        pcall(function()
            hum.PlatformStand = true
            hum.AutoRotate    = false
        end)
    end
    local bv = Instance.new("BodyVelocity")
    bv.Name      = "AutoFarm_BV"
    bv.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
    bv.P         = 1250
