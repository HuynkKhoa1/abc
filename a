local function getPositionFromInstance(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local ok, cf = pcall(function() return inst:GetPivot().Position end)
        if ok then return cf end
        if inst.PrimaryPart then return inst.PrimaryPart.Position end
    end
    if inst:IsA("ClickDetector") and inst.Parent and inst.Parent:IsA("BasePart") then
        return inst.Parent.Position
    end
    return nil
end

-- ClickDetector fallback đa-signature cho compat all-executor.
-- Volt: fireclickdetector(cd) — 1-arg
-- Krnl/Fluxus: fireclickdetector(cd, 0) — 2-arg
-- Synapse cũ: fireclickdetector(cd, 0, player) — 3-arg
-- Một số executor có alias riêng: click_detector_fire, FireClickDetector
-- → thử lần lượt tới khi 1 cái không error.
local function clickCD(cd)
    if not cd then return false end
    -- Method 1: fireclickdetector single-arg (Volt confirmed work)
    if fireclickdetector then
        local ok = pcall(function() fireclickdetector(cd) end)
        if ok then return true end
        -- Method 2: 2-arg with distance
        ok = pcall(function() fireclickdetector(cd, 0) end)
        if ok then return true end
        -- Method 3: 3-arg with player (legacy synapse)
        ok = pcall(function() fireclickdetector(cd, 0, player) end)
        if ok then return true end
    end
    -- Method 4: alias variants
    if click_detector_fire then
        local ok = pcall(function() click_detector_fire(cd) end)
        if ok then return true end
    end
    if FireClickDetector then
        local ok = pcall(function() FireClickDetector(cd) end)
        if ok then return true end
    end
    -- Method 5: firesignal trên MouseClick event
    if firesignal then
        local ok = pcall(function() firesignal(cd.MouseClick, player) end)
        if ok then return true end
    end
    -- Method 6: getconnections → call handlers trực tiếp
    if getconnections then
        local ok = pcall(function()
            for _, c in ipairs(getconnections(cd.MouseClick)) do
                if c.Function then c.Function(player) end
                if c.Fire then c:Fire(player) end
            end
        end)
        if ok then return true end
    end
    return false
end

