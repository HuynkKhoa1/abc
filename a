local function isInCombat()
    local char = player.Character
    if not char then return false end
    return (char:GetAttribute("CombatTag") or 0) > 0
end

local function ensureOutOfCombat(maxWait)
    maxWait = maxWait or 10
    local char = player.Character
    if not char then return false end
    if not isInCombat() then return true end

    local left = char:GetAttribute("CombatTagLeft") or 0
    if left > maxWait then
        setStatus(string.format("COMBAT TAG %.0fs > waiting too long, suicide", left))
        suicide()
        task.wait(4)
        return true
    end

    setStatus(string.format("WAITING COMBAT TAG %.1fs", left))
    local t = 0
    while t < maxWait do
        task.wait(0.25); t = t + 0.25
        local c = player.Character
        if not c then return false end
        local now = c:GetAttribute("CombatTagLeft") or 0
        if now <= 0 then return true end
        setStatus(string.format("WAITING COMBAT TAG %.1fs", now))
    end
    return not isInCombat()
end

