-- Flatten CODES table: also splits entries that contain commas
-- (so { "a,b,c" } and { "a","b","c" } both work)
local function flattenCodes(arr)
    local out = {}
    if type(arr) ~= "table" then return out end
    for _, entry in ipairs(arr) do
        if type(entry) == "string" then
            for tok in entry:gmatch("([^,]+)") do
                local code = tok:match("^%s*(.-)%s*$")
