local function waitChar(timeout)
    timeout = timeout or 30
    local start = tick()
    local char = player.Character
    while not char and (tick() - start) < timeout do
        char = player.Character
        if not char then
            pcall(function() char = player.CharacterAdded:Wait() end)
        end
        if not char then task.wait(0.5) end
    end

    if not char then
        dbg("waitChar: Timeout waiting for character")
        return nil, nil, nil
    end

    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    return char, hrp, hum
end

