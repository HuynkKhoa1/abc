local function handleGamePlaceSetup()

    local clientChooseName = player:FindFirstChild("ClientChooseName")
    if not clientChooseName then
        clientChooseName = player:WaitForChild("ClientChooseName", 5)
    end
    if not clientChooseName then
        dbg("No ClientChooseName found, skip creation")
        return false
    end

    local charName = pickRandomName()
    local gender   = pickRandomGender()

    dbg(string.format("Creating character: Name=%s | Gender=%s | Race=hollow", charName, gender))
    setStatus("CREATING: " .. charName)

    clientChooseName:FireServer(charName, gender, "hollow")
    task.wait(0.5)
    clientChooseName:FireServer(charName, gender, "hollow", true)

    dbg("Character creation sent, waiting for spawn...")
    setStatus("WAITING SPAWN...")
    return true
end

local potatoApplied        = false
local potatoVFXConn        = nil

local POTATO_PROTECTED_NAMES = {
    AutoFarmStatus     = true,
    QueueUI            = true,
    DisplayUI          = true,
    NameSelectionUI    = true,
}

local function potatoIsProtected(inst)
    local cur = inst
    while cur and cur ~= game do
        if POTATO_PROTECTED_NAMES[cur.Name] then return true end
        cur = cur.Parent
    end
    return false
end

function potatoKillVFX(d)
    if not d or potatoIsProtected(d) then return end
    if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail")
       or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
        pcall(function() d.Enabled = false end)
    elseif d:IsA("Explosion") then
        pcall(function() d.BlastPressure = 0; d.Visible = false end)
    elseif CONFIG.KILL_SOUNDS and d:IsA("Sound") then
        pcall(function() d.Volume = 0; d:Stop() end)
    end
end

local function applyPotatoMode()
    if not CONFIG.POTATO_MODE or potatoApplied then return end
    potatoApplied = true
    dbg("Applying Potato Mode...")

    pcall(function() if setfpscap then setfpscap(CONFIG.FPS_CAP or 30) end end)
    pcall(function() if set_fps_cap then set_fps_cap(CONFIG.FPS_CAP or 30) end end)

    pcall(function()
        local us = UserSettings():GetService("UserGameSettings")
        us.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        if CONFIG.KILL_SOUNDS then us.MasterVolume = 0 end
    end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = false
        Lighting.FogEnd        = 1e9
        Lighting.Brightness    = 1
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere")
               or v:IsA("Sky") or v:IsA("Clouds") then
                pcall(function() v:Destroy() end)
            end
        end
    end)

    pcall(function()
        local t = Workspace.Terrain
        t.Decoration       = false
        t.WaterWaveSize    = 0
        t.WaterWaveSpeed   = 0
        t.WaterReflectance = 0
        t.WaterTransparency = 1
    end)
    pcall(function() Workspace.GlobalWind = Vector3.zero end)

    pcall(function()
        local sg = game:GetService("StarterGui")
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.Chat,        false)
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,  false)
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu,  false)
        sg:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,    false)
    end)

    if CONFIG.DISABLE_IDLED_KICK then
        pcall(function()
            if not getconnections then return end
            for _, c in ipairs(getconnections(player.Idled)) do
                if c.Disable then pcall(function() c:Disable() end) end
            end
        end)
    end

    for _, d in ipairs(Workspace:GetDescendants()) do potatoKillVFX(d) end
    if CONFIG.KILL_SOUNDS then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("Sound") then pcall(function() d.Volume = 0 end) end
        end
    end

    if CONFIG.STRIP_VFX_CONTINUOUS then
        if potatoVFXConn then potatoVFXConn:Disconnect() end
        potatoVFXConn = Workspace.DescendantAdded:Connect(potatoKillVFX)
    end

    dbg("Potato Mode applied (FPS=" .. tostring(CONFIG.FPS_CAP) .. ", quality=1)")
end

local function waitForGameReady()

    if not game:IsLoaded() then
        dbg("Waiting for game to load...")
        setStatus("WAITING GAME LOAD...")
        game.Loaded:Wait()
    end
    dbg("Game loaded")

    applyPotatoMode()

    task.wait(2)

    setStatus("WAITING REMOTES...")
    local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
    if not remotes then warn("[AutoFarm] Remotes not found"); return end

    local getDataRemote = remotes:WaitForChild("GetReadableData", 15)

    if game.PlaceId == PLACE_GAME and getDataRemote then
        setStatus("CHECKING RACE...")

        local data, lastErr
        for attempt = 1, 6 do
            local ok, ret = pcall(function() return getDataRemote:InvokeServer() end)
            if ok and type(ret) == "table" then
                data = ret
                dbg("GetReadableData OK on attempt #" .. attempt)
                break
            end
            lastErr = ret
            dbg("GetReadableData fail #" .. attempt .. ": " .. tostring(ret))
            setStatus(string.format("CHECKING RACE... (retry %d/6)", attempt))
            task.wait(2)
        end

        if not data then
            warn("[AutoFarm] GetReadableData failed 6x → rejoin to recover. Last err: " .. tostring(lastErr))
            setStatus("DATA FETCH FAILED → REJOIN")
            task.wait(1)
            pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
            task.wait(20)
            return
        end

        local race = nil
        for _, k in ipairs({"Race", "race", "PlayerRace"}) do
            if data[k] then race = tostring(data[k]):lower(); break end
        end
        if not race then
            for _, c in ipairs({"Stats", "Progression", "Player", "Data", "Profile"}) do
                if type(data[c]) == "table" then
                    for _, k in ipairs({"Race", "race"}) do
                        if data[c][k] then race = tostring(data[c][k]):lower(); break end
                    end
                end
                if race then break end
            end
        end

        dbg("Race = " .. tostring(race))

        -- HOLLOW = vứt slot. Hollow trong PLACE_GAME → mark current slot
        -- là bad, set nextSlot, teleport về lobby. Lobby sẽ đọc state +
        -- chọn slot khác. Cứ thế tới khi tìm được non-Hollow hoặc hết slot.
        if race == "hollow" then
            local state = readSlotState()
            local cur   = state.currentSlot or "A"
            local tried = {}
            if type(state.triedSlots) == "table" then
                for _, s in ipairs(state.triedSlots) do
                    if type(s) == "string" then table.insert(tried, s) end
                end
            end
            local already = false
            for _, s in ipairs(tried) do if s == cur then already = true; break end end
            if not already then table.insert(tried, cur) end

            local nextSlot = pickNextSlot(tried)
            warn(string.format("[AutoFarm] GAME: Race=Hollow on slot %s → DISCARD. Tried=[%s], next=%s",
                cur, table.concat(tried, ","), tostring(nextSlot)))
            setStatus("HOLLOW SLOT → BACK TO LOBBY")

            writeSlotState({
                currentSlot = nil,
                nextSlot    = nextSlot,
                triedSlots  = tried,
            })

            if not nextSlot then
                warn("[AutoFarm] All slots tried & all Hollow → game:Shutdown()")
                writeSlotState({})
                task.wait(1)
                pcall(function() game:Shutdown() end)
                return
            end

            task.wait(1)
            pcall(function() TeleportService:Teleport(14067600077, player) end)
            task.wait(25)
            return
        end

        if race == "lostsoul" or race == "lost soul" then
            dbg("LostSoul detected → creating Hollow character")
            handleGamePlaceSetup()

            local initialChar = player.Character
            local spawned     = false
            local t = 0
            while t < 25 and not spawned do
                task.wait(0.5); t = t + 0.5
                local c = player.Character
                if c and c ~= initialChar and c:FindFirstChild("HumanoidRootPart") then
                    spawned = true
                end
            end
            if not spawned then
                warn("[AutoFarm] Char did not spawn after creation in 25s → rejoin")
                setStatus("SPAWN STUCK → REJOIN")
                task.wait(1)
                pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
                task.wait(20)
                return
            end
            task.wait(2)

            -- Sau khi tạo Hollow → recheck race; nếu vẫn hollow → discard
            -- slot (cùng logic). Nếu hết slot khả dụng → fallthrough farm.
            local recheck = nil
            local okR, ret = pcall(function() return getDataRemote:InvokeServer() end)
            if okR and type(ret) == "table" then
                for _, k in ipairs({"Race", "race", "PlayerRace"}) do
                    if ret[k] then recheck = tostring(ret[k]):lower(); break end
                end
            end
            dbg("After Hollow creation, race = " .. tostring(recheck))
            if recheck == "hollow" then
                local state = readSlotState()
                local cur   = state.currentSlot or "A"
                local tried = {}
                if type(state.triedSlots) == "table" then
                    for _, s in ipairs(state.triedSlots) do
                        if type(s) == "string" then table.insert(tried, s) end
                    end
                end
                local already = false
                for _, s in ipairs(tried) do if s == cur then already = true; break end end
                if not already then table.insert(tried, cur) end
                local nextSlot = pickNextSlot(tried)
                if nextSlot then
                    warn(string.format("[AutoFarm] GAME: Created Hollow on slot %s — discard, next=%s",
                        cur, nextSlot))
                    writeSlotState({ currentSlot = nil, nextSlot = nextSlot, triedSlots = tried })
                    task.wait(1)
                    pcall(function() TeleportService:Teleport(14067600077, player) end)
                    task.wait(25)
                    return
                else
                    dbg("All slots Hollow but no alternative — fall through and farm anyway")
                end
            end
        else
            dbg("Race is " .. tostring(race) .. ", no creation needed")
        end
    end

    setStatus("WAITING CHARACTER...")
    local char = waitChar(30)
    if not char then
        warn("[AutoFarm] No character after 30s → rejoin")
        setStatus("NO CHARACTER → REJOIN")
        task.wait(1)
        pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
        task.wait(20)
        return
    end
    dbg("Character check done")

    remotes:WaitForChild("ClientEffects", 15)
    remotes:WaitForChild("ServerCombatHandler", 15)

    setStatus("WAITING ENTITIES...")
    Workspace:WaitForChild("Entities", 30)

    setStatus("SETTLING...")
    task.wait(2)
    dbg("Game dependencies ready")
    setStatus("READY")
end

waitForGameReady()

installFocusCapture()
installRespawnHook()

waitChar()
task.wait(2)

local _initRank = getMyRank()
if _initRank and CONFIG.TARGET_STOP_RANK and _initRank <= CONFIG.TARGET_STOP_RANK then
    setStatus(string.format("RANK %d ≤ %d — TARGET REACHED → SHUTDOWN", _initRank, CONFIG.TARGET_STOP_RANK))
    dbg(string.format("INIT: Already at target rank %d (target ≤ %d) — calling game:Shutdown()",
        _initRank, CONFIG.TARGET_STOP_RANK))
    task.wait(1)
    pcall(function() game:Shutdown() end)
    return
end

refreshGrimmjowFlag()
if hasGrimmjow then
    task.wait(1)

    local detected = false
    for i = 1, 3 do
        if testHasPartialRes() then detected = true; break end
        task.wait(0.8)
    end
    if detected then
        hasPartialRes = true
        dbg("INIT: Both Grimmjow + PartialRes detected → skip rank-7 entirely")
    else
        dbg("INIT: Has Grimmjow, missing PartialRes — will run partial res only at rank 7")
    end
end

startFarm()
