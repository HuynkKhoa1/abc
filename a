local function doHollowEvolution()
    dbg("=== Hollow Evolution START ===")
    setStatus("HOLLOW → Finding Menos...")

    local menos, menosHrp = findMenosEntity()
    if not menos then
        setStatus("NO MENOS FOUND → HOP")
        dbg("No Menos entity in server, hopping...")
        hopToServer(false)
        return false
    end

    dbg("Found Menos: " .. menos.Name)
    setStatus("HOLLOW → Flying to " .. menos.Name)
    ensureWeaponDrawn()

    local _, hrp = waitChar()
    if not hrp then return false end

    -- Menos hình chai nước (cao + hẹp). Damage chỉ register khi mình ở
    -- TRONG volume vertical của menos → bắt buộc XZ ≈ 0 (align với menos).
    -- Spread ngang (±X / ±Z) = ra ngoài volume = không gây damage.
    --
    -- Multi-acc: nhiều player cùng đánh 1 menos → phải stack theo trục Y
    -- (dọc), mỗi acc cách nhau ≥ 5 stud. Hàm này quét player khác đang gần
    -- menos (XZ ≤ 10 stud), thu thập Y-offset, pick slot Y không trùng.
    local function pickMenosOffset(targetMenos, targetHrp)
        if not targetHrp then
            return Vector3.new(0, math.random(4, 14), 0)
        end
        local mPos = targetHrp.Position
        local takenY = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                if pHrp then
                    local dx = pHrp.Position.X - mPos.X
                    local dz = pHrp.Position.Z - mPos.Z
                    local distXZ = math.sqrt(dx * dx + dz * dz)
                    if distXZ <= 10 then
                        table.insert(takenY, pHrp.Position.Y - mPos.Y)
                    end
                end
            end
        end
        for h = 4, 49, 5 do
            local clash = false
            for _, y in ipairs(takenY) do
                if math.abs(h - y) < 5 then clash = true; break end
            end
            if not clash then
                dbg(string.format("pickMenosOffset: Y=%d (others=%d nearby)", h, #takenY))
                return Vector3.new(0, h, 0)
            end
        end
        local fallbackY = 50 + math.random(0, 15)
        dbg(string.format("pickMenosOffset: all slots taken (n=%d), fallback Y=%d",
            #takenY, fallbackY))
        return Vector3.new(0, fallbackY, 0)
    end
    local randomMenosOffset = function() return pickMenosOffset(menos, menosHrp) end

    local menosOffset = randomMenosOffset()
    dbg(string.format("Menos hover offset: (%.0f, %.0f, %.0f)",
        menosOffset.X, menosOffset.Y, menosOffset.Z))

    enableNoclip()
    flyTo(menosHrp.Position + menosOffset, CONFIG.FLY_SPEED, 8, 15)
    task.wait(0.3)

    setStatus("HOLLOW → Attacking " .. menos.Name)

    lockedHorizFwd = nil
    stopFlight()
    local f = setupFlight()
    if not f then return false end

    local stop = false
    local conn = RunService.Heartbeat:Connect(function()
        if stop or not f.hrp or not f.hrp.Parent then return end
        if not menos.Parent or not menosHrp.Parent then stop = true; return end

        local tgtPos   = menosHrp.Position
        local hoverPos = tgtPos + menosOffset
        local toHover  = hoverPos - f.hrp.Position
        local d        = toHover.Magnitude

        if d > 0.5 then
            f.bv.Velocity = toHover.Unit * math.min(CONFIG.HOVER_SPEED, d * 8)
        else
            f.bv.Velocity = Vector3.zero
        end

        local desired = faceDownCFrame(f.hrp.Position, tgtPos)
        f.bg.CFrame   = desired
        pcall(function()
            local rot = desired - desired.Position
            f.hrp.CFrame = CFrame.new(f.hrp.Position) * rot
        end)
    end)
    activeFlight = { bv = f.bv, bg = f.bg, hum = f.hum, conn = conn }

    local approachT = 0
    while approachT < 2 do
        task.wait(0.05); approachT = approachT + 0.05
        if not menosHrp.Parent then stop = true; break end
        local hoverPos = menosHrp.Position + menosOffset
        if (f.hrp.Position - hoverPos).Magnitude <= 8 then break end
    end

    -- Damage-tracker: nếu Menos.Humanoid.Health KHÔNG giảm trong STUCK_HP_TIMEOUT
    -- giây dù đang đánh = quái bug (invincible / proxy lỗi / chưa replicate
    -- đúng) → coi như despawn, chuyển sang Menos kế tiếp.
    local STUCK_HP_TIMEOUT = 6
    local lastMenosHp = nil
    local lastHpDropAt = tick()
    local function refreshMenosHp(reason)
        local hum = menos and menos:FindFirstChildOfClass("Humanoid")
        lastMenosHp  = hum and hum.Health or nil
        lastHpDropAt = tick()
        if reason then dbg("Menos HP tracker reset: " .. reason) end
    end
    refreshMenosHp("initial")

    -- Blacklist các Menos đã bị bugged để không quay lại đánh chính nó.
    -- findMenosEntity trả về Menos_ đầu tiên → nếu không skip, có thể loop
    -- vô tận trên cùng 1 con bug.
    local _buggedMenos = {}
    local function findFreshMenos()
        local entFolder = Workspace:FindFirstChild("Entities")
        if not entFolder then return nil, nil end
        for _, npc in ipairs(entFolder:GetChildren()) do
            if npc:IsA("Model") and npc.Name:match("^Menos_") and not _buggedMenos[npc] then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then return npc, hrp end
            end
        end
        return nil, nil
    end

    local evolved = false
    while true do
        -- Damage-tracker check.
        local buggedMenos = false
        do
            local hum = menos and menos:FindFirstChildOfClass("Humanoid")
            local curHp = hum and hum.Health
            if curHp and lastMenosHp and curHp < lastMenosHp then
                lastMenosHp  = curHp
                lastHpDropAt = tick()
            elseif curHp and lastMenosHp == nil then
                lastMenosHp = curHp
            end
            if curHp and tick() - lastHpDropAt > STUCK_HP_TIMEOUT then
                warn(string.format("[AutoFarm] Menos %s HP stuck at %s for %ds — bugged, skipping",
                    tostring(menos and menos.Name), tostring(lastMenosHp), STUCK_HP_TIMEOUT))
                setStatus("HOLLOW → BUGGED MENOS, SKIP")
                if menos then _buggedMenos[menos] = true end
                buggedMenos = true
            end
        end

        if not menos.Parent or not menosHrp.Parent or buggedMenos then

            dbg(buggedMenos and "Menos bugged, looking for next target..."
                or "Menos despawned, looking for next target...")
            stop = true
            stopFlight()

            local nextMenos, nextHrp = findFreshMenos()
            if nextMenos and nextMenos ~= menos then
                dbg("Found next Menos: " .. nextMenos.Name)
                setStatus("HOLLOW → Switching to " .. nextMenos.Name)
                menos = nextMenos
                menosHrp = nextHrp
                stop = false
                refreshMenosHp("switched to next menos")

                menosOffset = randomMenosOffset()
                dbg(string.format("New menos offset: (%.0f, %.0f, %.0f)",
                    menosOffset.X, menosOffset.Y, menosOffset.Z))

                flyTo(menosHrp.Position + menosOffset, CONFIG.FLY_SPEED, 8, 15)
                task.wait(0.3)
                lockedHorizFwd = nil
                local f2 = setupFlight()
                if not f2 then return false end
                f = f2
                conn:Disconnect()
                conn = RunService.Heartbeat:Connect(function()
                    if stop or not f.hrp or not f.hrp.Parent then return end
                    if not menos.Parent or not menosHrp.Parent then stop = true; return end
                    local tgtPos   = menosHrp.Position
                    local hoverPos = tgtPos + menosOffset
                    local toHover  = hoverPos - f.hrp.Position
                    local d        = toHover.Magnitude
                    if d > 0.5 then
                        f.bv.Velocity = toHover.Unit * math.min(CONFIG.HOVER_SPEED, d * 8)
                    else
                        f.bv.Velocity = Vector3.zero
                    end
                    local desired = faceDownCFrame(f.hrp.Position, tgtPos)
                    f.bg.CFrame   = desired
                    pcall(function()
                        local rot = desired - desired.Position
                        f.hrp.CFrame = CFrame.new(f.hrp.Position) * rot
                    end)
                end)
                activeFlight = { bv = f.bv, bg = f.bg, hum = f.hum, conn = conn }
            else

                dbg("No Menos left in server, hopping")
                setStatus("NO MENOS LEFT → HOP")
                hopToServer(false)
                return false
            end
        end

        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            dbg("Character died during Menos attack, waiting respawn...")
            stop = true
            stopFlight()
            waitChar()
            task.wait(2)
            setStatus("DIED DURING MENOS → RETRY")
            return false
        end

        local rank = getMyRank()
        if rank and rank <= CONFIG.MENOS_RANK then
            evolved = true
            break
        end

        fireM1()
        task.wait(jitter(CONFIG.M1_INTERVAL_MIN, CONFIG.M1_INTERVAL_MAX))
    end

    stop = true
    stopFlight()

    if evolved then
        dbg("Evolved to Menos (rank 17)")
        setStatus("MENOS RANK REACHED → TRANSFORM")
        task.wait(1)
        fireHollowTransformRemote()

        setStatus("WAITING RANK → 9...")
        local waitT = 0
        while waitT < 15 do
            task.wait(0.5); waitT = waitT + 0.5
            local r = getMyRank()
            if r and r <= 9 then
                dbg("Rank is now " .. r .. " → ready to farm")
                setStatus("RANK " .. r .. " → READY TO FARM")
                return true
            end
        end
        dbg("Rank didn't drop to 9 after transform, current: " .. tostring(getMyRank()))
        return true
    end

    return false
end

local function evaluateRankAction()
    local rank = getMyRank()
    if not rank then return "continue", nil end
    if CONFIG.TARGET_STOP_RANK and rank <= CONFIG.TARGET_STOP_RANK then
        return "stop", rank
    end
    if rank >= CONFIG.HOLLOW_RANK then
        return "hollow", rank
    end
    if rank >= CONFIG.MENOS_RANK then
        return "menos", rank
    end
    -- Adjuchas (rank 16): hollow→menos lố qua 1 stage. Cũng fire
    -- HollowTransform (Ctrl+K) y như Menos để chuyển tiếp.
    if rank == CONFIG.ADJUCHAS_RANK then
        return "adjuchas", rank
    end
    if rank > 9 then
        return "hop", rank
    end
    if CONFIG.PARTIAL_RES_RANK and rank == CONFIG.PARTIAL_RES_RANK then
        if hasGrimmjow and hasPartialRes then
            return "continue", rank
        end
        return "partialres", rank
    end
    return "continue", rank
end

local function startFarm()
    if farmRunning then warn("[AutoFarm] Already running") return end

    local currentRank = getMyRank()
    if currentRank and CONFIG.TARGET_STOP_RANK and currentRank <= CONFIG.TARGET_STOP_RANK then
        setStatus(string.format("RANK %d ≤ %d — TARGET REACHED → SHUTDOWN", currentRank, CONFIG.TARGET_STOP_RANK))
        dbg(string.format("Already at target rank %d (target ≤ %d) — calling game:Shutdown()",
            currentRank, CONFIG.TARGET_STOP_RANK))
        task.wait(1)
        pcall(function() game:Shutdown() end)
        return
    end

    farmRunning = true
    farmStop    = false
    installFocusCapture()

    task.spawn(function()
        local baselinePos, baselineTime
        local TIMEOUT = CONFIG.STUCK_TIMEOUT or 30
        local MOVE    = CONFIG.STUCK_MOVE_THRESHOLD or 15
        while not farmStop do
            task.wait(3)
            local char, hrp, hum = getChar()
            if not hrp or not hum or hum.Health <= 0 then
                baselinePos  = nil
                baselineTime = nil
            else
                local inCombat = char and ((char:GetAttribute("CombatTag") or 0) > 0)
                local hasTarget = false
                if not inCombat then
                    local entFolder = Workspace:FindFirstChild("Entities")
                    if entFolder then
                        local myName = player.Name
                        local hrpPos = hrp.Position
                        for _, npc in ipairs(entFolder:GetChildren()) do
                            if npc:IsA("Model") then
                                local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                                    or npc:FindFirstChild("Torso") or npc.PrimaryPart
                                if npcHrp and (npcHrp.Position - hrpPos).Magnitude <= CONFIG.AGGRO_RANGE then
                                    local pref = npc:GetAttribute("PreferredTargets")
                                    local state = npc:GetAttribute("CurrentState")
                                    if state ~= "Unconscious" and (
                                        npc.Name:match("^Shinigami_")
                                        or (pref and tostring(pref):find(myName, 1, true))
                                    ) then
                                        hasTarget = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

                if inCombat or hasTarget then
                    baselinePos  = hrp.Position
                    baselineTime = tick()
                else
                    local pos = hrp.Position
                    if not baselinePos then
                        baselinePos  = pos
                        baselineTime = tick()
                    elseif (pos - baselinePos).Magnitude > MOVE then
                        baselinePos  = pos
                        baselineTime = tick()
                    elseif tick() - baselineTime > TIMEOUT then
                        setStatus(string.format("STUCK %ds → SUICIDE", TIMEOUT))
                        dbg(string.format("Stuck watchdog: no net move > %d studs in %ds (not in combat, no targets) → suicide",
                            MOVE, TIMEOUT))
                        stopFlight()
                        suicide()
                        task.wait(5)
                        baselinePos  = nil
                        baselineTime = nil
                    end
                end
            end
        end
    end)

    -- Low-HP suicide watcher: HP < 10% → suicide ngay.
    -- LÝ DO: die-by-player có pattern khác die-by-self trên server log.
    -- Bot bị PvP killed liên tục là 1 flag detect dễ. Tự suicide trước =
    -- clean reset, AC chỉ thấy death-by-self.
    -- CHỈ active cho rank ≤ 9 (Shinigami progression). Trên hollow path
    -- (hollow/menos/adjuchas), death-by-player k phải vấn đề vì XP grind
    -- nhanh + suicide làm gián đoạn evolution flow.
    task.spawn(function()
        local LOW_HP_THRESHOLD = 0.10
        local lastSuicideAt    = 0
        local HOLLOW_RACES     = { hollow = true, menos = true, adjuchas = true }
        while not farmStop do
            task.wait(0.5)
            local race        = getMyRace and getMyRace() or nil
            local currentRank = getMyRank and getMyRank() or nil
            -- Skip nếu đang ở hollow path hoặc rank chưa đủ cao (>9).
            if race and HOLLOW_RACES[race] then
                -- pass — không suicide khi đang grind hollow line
            elseif currentRank and currentRank > 9 then
                -- pass — rank thấp (số > 9), chưa cần bảo vệ PvP pattern
            else
                local _, _, hum = getChar()
                if hum and hum.Health > 0 and hum.MaxHealth and hum.MaxHealth > 0 then
                    local ratio = hum.Health / hum.MaxHealth
                    if ratio < LOW_HP_THRESHOLD and tick() - lastSuicideAt > 5 then
                        setStatus(string.format("HP %.0f%% < 10%% → SUICIDE", ratio * 100))
                        dbg(string.format("Low-HP suicide: %.1f/%.1f (%.1f%%) rank=%s race=%s",
                            hum.Health, hum.MaxHealth, ratio * 100,
                            tostring(currentRank), tostring(race)))
                        stopFlight()
                        suicide()
                        lastSuicideAt = tick()
                    end
                end
            end
        end
    end)

    task.spawn(function()
        local consecutiveR7Fails = 0
        local consecutiveBoardFails = 0
        while not farmStop do

            if isServerRaid() then
                setStatus("SERVER RAID ACTIVE → HOP")
                dbg("ServerRaid attribute is true, hopping...")
                hopToServer(false)
                task.wait(2)
            else

            local action, rank = evaluateRankAction()

            if action == "stop" then
                setStatus("TARGET RANK " .. tostring(rank) .. " REACHED ✓ SHUTDOWN")
                dbg("Target stop rank " .. tostring(rank) .. " reached — calling game:Shutdown()")
                farmStop = true
                task.wait(1)
                pcall(function() game:Shutdown() end)
                break

            elseif action == "hollow" then
                setStatus("RANK " .. tostring(rank) .. " → HOLLOW EVOLUTION")
                dbg("Rank " .. tostring(rank) .. " = Hollow, starting evolution")
                local ok, err = pcall(doHollowEvolution)
                if not ok then warn("[AutoFarm] Hollow evolution error: " .. tostring(err)) end
                task.wait(jitter(1, 2))

            elseif action == "menos" then
                setStatus("RANK " .. tostring(rank) .. " → MENOS TRANSFORM")
                dbg("Rank 17 = Menos, firing HollowTransform")
                pcall(fireHollowTransformRemote)
                task.wait(3)

            elseif action == "adjuchas" then
                setStatus("RANK " .. tostring(rank) .. " ADJUCHAS → TRANSFORM (Ctrl+K)")
                dbg("Rank 16 = Adjuchas (lố qua Menos) — firing HollowTransform")
                pcall(fireHollowTransformRemote)
                task.wait(3)

            elseif action == "hop" then
                setStatus("RANK " .. tostring(rank) .. " → HOPPING SERVER")
                dbg("Intermediate rank " .. tostring(rank) .. ", hopping to new server")
                hopToServer(false)

            elseif action == "partialres" then
                setStatus("RANK " .. tostring(rank) .. " ▸ RANK-7 SEQUENCE")
                dbg("=== Rank-7 sequence (consecutive fails: " .. consecutiveR7Fails .. ") ===")
                local ok, result = pcall(runRankSevenSequence)
                if not ok then
                    warn("[AutoFarm] Rank7 sequence error: " .. tostring(result))
                    consecutiveR7Fails = consecutiveR7Fails + 1
                elseif result == false then
                    consecutiveR7Fails = consecutiveR7Fails + 1
                    dbg("Rank-7 sequence returned false, fails=" .. consecutiveR7Fails)
                else
                    consecutiveR7Fails = 0
                end

                if consecutiveR7Fails >= 3 then
                    setStatus("RANK7 FAILED 3x → SERVER HOP")
                    dbg("Too many consecutive Rank-7 fails, hopping server")
                    consecutiveR7Fails = 0
                    hopToServer(false)
                else
                    task.wait(jitter(3, 5))
                end

            else

                if #Players:GetPlayers() > CONFIG.MAX_SERVER_PLAYERS then
                    setStatus("SERVER CROWDED (" .. #Players:GetPlayers() .. "p) → HOP LOW POP")
                    dbg("Server has " .. #Players:GetPlayers() .. " players, hopping to low pop")
                    hopToServer(true)
                else
                    if rank then dbg(string.format("Current rank: %d (target: %s)", rank, tostring(CONFIG.TARGET_STOP_RANK))) end
                    local ok, err = pcall(runOneCycle)
                    if ok and err == false then

                        consecutiveBoardFails = consecutiveBoardFails + 1
                        dbg("Board/mission fail #" .. consecutiveBoardFails)
                        if consecutiveBoardFails >= 2 then
                            setStatus("BOARD FAIL 5x → SERVER HOP")
                            dbg("5 consecutive board fails, hopping server")
                            consecutiveBoardFails = 0
                            hopToServer(false)
                        end
                    elseif not ok then
                        warn("[AutoFarm] Cycle error: " .. tostring(err))
                    else
                        consecutiveBoardFails = 0
                    end
                    if farmStop then break end
                    task.wait(jitter(0.4, 0.9))
                end
            end
            end
        end
        farmRunning = false
        stopFlight()
        disableNoclip()
        stopRollListener()
        setStatus("FARM STOPPED")
    end)
end

local function stopFarm()
    farmStop = true
    stopFlight()
    disableNoclip()
    stopRollListener()
    stopCapturingDialogueSession()
    setStatus("")
end

