-- ╔════════════════════════════════════════════════════════════╗
-- ║  SLOT STATE — persist across teleport via file              ║
-- ╚════════════════════════════════════════════════════════════╝
-- Mục tiêu: né slot Hollow trong PLACE_GAME. Game→Lobby teleport mất sạch
-- TeleportData (server-side), nên dùng filesystem (writefile/readfile) để
-- track slot đang chạy + danh sách slot đã bị "vứt".
-- File per-UserId tránh conflict đa-acc.
local SLOT_STATE_FILE = string.format("typesoul_slot_state_%d.json", player.UserId or 0)
local SLOT_ORDER      = { "A", "B", "C", "D", "E", "F" }

local function readSlotState()
    if not (isfile and readfile) then return {} end
    local okExist, exists = pcall(isfile, SLOT_STATE_FILE)
    if not okExist or not exists then return {} end
    local okR, content = pcall(readfile, SLOT_STATE_FILE)
    if not okR or type(content) ~= "string" then return {} end
    local okD, data = pcall(function() return HttpService:JSONDecode(content) end)
    if okD and type(data) == "table" then return data end
    return {}
end

local function writeSlotState(state)
    if not writefile then return end
    pcall(function()
        writefile(SLOT_STATE_FILE, HttpService:JSONEncode(state))
    end)
end

local function pickNextSlot(triedSlots)
    triedSlots = triedSlots or {}
    local trySet = {}
    for _, s in ipairs(triedSlots) do trySet[s] = true end
    for _, s in ipairs(SLOT_ORDER) do
        if not trySet[s] then return s end
    end
    return nil  -- tất cả đã thử
end

if game.PlaceId == 14067600077 then
    if not game:IsLoaded() then game.Loaded:Wait() end

    task.wait(6)

    local LOBBY_PLACE = 14067600077

    local function lobbyRejoin(reason)
        warn("[AutoFarm] LOBBY: " .. reason .. " → rejoin")
        pcall(function() TeleportService:Teleport(LOBBY_PLACE, player) end)
        task.wait(25)
    end

    local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
    if not remotes then
        lobbyRejoin("Remotes folder not found")
        return
    end

    local chooseSlot = remotes:WaitForChild("ChooseSlot", 15)
    local teleport   = remotes:WaitForChild("Teleport",   15)
    if not chooseSlot or not teleport then
        lobbyRejoin("ChooseSlot/Teleport remote missing")
        return
    end

    -- Đọc slot state. Nếu game-side đã set nextSlot (do detect hollow) →
    -- dùng cái đó. Default "A".
    local state    = readSlotState()
    local triedRaw = state.triedSlots
    local tried    = {}
    if type(triedRaw) == "table" then
        for _, s in ipairs(triedRaw) do
            if type(s) == "string" then table.insert(tried, s) end
        end
    end
    local slot = state.nextSlot
    if type(slot) ~= "string" or #slot == 0 then
        slot = pickNextSlot(tried) or "A"
    end

    if #tried >= #SLOT_ORDER then
        warn(string.format("[AutoFarm] LOBBY: All %d slots marked Hollow → shutdown", #tried))
        writeSlotState({})
        pcall(function() game:Shutdown() end)
        return
    end

    state.currentSlot = slot
    state.nextSlot    = nil
    state.triedSlots  = tried
    writeSlotState(state)

    print(string.format("[AutoFarm] LOBBY: Using slot %s (tried so far: %d)", slot, #tried))

    local SUCCESS = false
    for attempt = 1, 5 do
        print(string.format("[AutoFarm] LOBBY: Attempt #%d — Selecting slot %s...", attempt, slot))

        local okC, errC = pcall(function() chooseSlot:InvokeServer(slot) end)
        if not okC then
            warn("[AutoFarm] LOBBY: ChooseSlot error: " .. tostring(errC))
        end
        task.wait(1.5)

        local okT, errT = pcall(function() teleport:InvokeServer({}) end)
        if not okT then
            warn("[AutoFarm] LOBBY: Teleport error: " .. tostring(errT))
        end
        print("[AutoFarm] LOBBY: Teleport invoked, waiting for actual teleport...")

        local t = 0
        while t < 12 do
            task.wait(0.5); t = t + 0.5
            if game.PlaceId ~= LOBBY_PLACE then
                SUCCESS = true
                break
            end
        end
        if SUCCESS then break end

        warn(string.format("[AutoFarm] LOBBY: Attempt #%d didn't teleport in 12s, retrying...", attempt))
        task.wait(2)
    end

    if not SUCCESS then
        lobbyRejoin("5 retries failed (still in lobby)")
    end

    return
end

