local function doPartialRes()
    dbg("=== Partial Res flow START ===")
    enableNoclip()
    setStatus("PARTIAL RES ▸ Step 1: PartialRes NPC")

    local partialRoot = Workspace:FindFirstChild("NPCs") and Workspace.NPCs:FindFirstChild("PartialRes")
    if not partialRoot then warn("[AutoFarm] PartialRes folder not found"); disableNoclip(); return false end
    debugListChildren(partialRoot, "PartialRes folder")

    local nodeP = findChildCaseInsensitive(partialRoot, "PartialRes")
    local cd1   = nodeP and findFirstClickDetectorIn(nodeP)
    local pos1  = cd1 and (cd1.Parent and cd1.Parent:IsA("BasePart") and cd1.Parent.Position) or getPositionFromInstance(nodeP)
    if not cd1 or not pos1 then
        warn("[AutoFarm] Step1 CD/pos not found")
        if nodeP then debugListChildren(nodeP, "Step1 node") end
        disableNoclip()
        return false
    end

    if not flyTo(pos1 + Vector3.new(0, 4, 0), CONFIG.FLY_SPEED, 5, 20) then
        warn("[AutoFarm] Step1 fly timeout"); disableNoclip(); return false
    end
    task.wait(jitter(0.2, 0.4))
    clickCD(cd1)
    dbg("Step1 clicked")
    task.wait(0.8)

    setStatus("PARTIAL RES ▸ Streaming → Hogyoku Fragment")

    stopFlight()
    local f = setupFlight()
    if not f then disableNoclip(); return false end

    local hogyokuInst, hogyokuCD, hogyokuPos
    local wpIdx        = 1
    local stop         = false
    local arrived      = false
    local ARRIVE_RADIUS = 6

    local conn = RunService.Heartbeat:Connect(function()
        if stop or not f.hrp or not f.hrp.Parent then return end

        if not hogyokuInst then
            local h = findChildCaseInsensitive(partialRoot, "Hogyoku Fragment")
            if h then
                local cd = findFirstClickDetectorIn(h)
                local pos = (cd and cd.Parent and cd.Parent:IsA("BasePart") and cd.Parent.Position)
                    or getPositionFromInstance(h)
                if cd and pos then
                    hogyokuInst = h
                    hogyokuCD   = cd
                    hogyokuPos  = pos
                end
            end
        end

        local target
        if hogyokuInst then
            target = hogyokuPos + Vector3.new(0, 4, 0)
        else
            local wp = PARTIAL_WAYPOINTS[wpIdx]
            target = wp and wp.Position
        end
        if not target then return end

        local toT = target - f.hrp.Position
        local d   = toT.Magnitude

        if d <= ARRIVE_RADIUS then
            if hogyokuInst then
                f.bv.Velocity = Vector3.zero
                arrived = true
                return
            elseif wpIdx < #PARTIAL_WAYPOINTS then
                wpIdx = wpIdx + 1
            end
        end

        f.bv.Velocity = toT.Unit * math.min(CONFIG.FLY_SPEED, d * 8)
        local look = Vector3.new(target.X, f.hrp.Position.Y, target.Z)
        f.bg.CFrame = CFrame.lookAt(f.hrp.Position, look)
    end)
    activeFlight = { bv = f.bv, bg = f.bg, hum = f.hum, conn = conn }

    local startT     = tick()
    local STREAM_TO  = 35
    local lastWPIdx  = -1
    while not arrived and tick() - startT < STREAM_TO do
        if hogyokuInst then
            setStatus("PARTIAL RES ▸ FLYING TO HOGYOKU")
        elseif wpIdx ~= lastWPIdx then
            setStatus(string.format("PARTIAL RES ▸ Streaming WP %d/%d", wpIdx, #PARTIAL_WAYPOINTS))
            lastWPIdx = wpIdx
        end
        task.wait(0.1)
    end
    stop = true
    stopFlight()

    if not hogyokuInst then
        warn(string.format("[AutoFarm] Hogyoku Fragment never appeared in %ds", STREAM_TO))
        debugListChildren(partialRoot, "PartialRes folder NOW")
        disableNoclip()
        return false
    end
    if not arrived then
        warn("[AutoFarm] Hogyoku found but flight timeout")
        disableNoclip()
        return false
    end
    dbg("Step2: arrived at Hogyoku = " .. hogyokuInst:GetFullName())

    task.wait(jitter(0.2, 0.4))
    clickCD(hogyokuCD)
    dbg("Step2 clicked")
    task.wait(jitter(0.6, 1.2))

    setStatus("PARTIAL RES ▸ Step 3: Effects item")
    local effects = Workspace:WaitForChild("Effects", 8)
    local myEff   = effects and effects:WaitForChild(player.Name, 12)
    local resItem = myEff and myEff:WaitForChild(player.Name .. "PartialResItem", 12)
    local items   = resItem and resItem:WaitForChild("Items", 12)
    local cd3     = items and findFirstClickDetectorIn(items)
    if not cd3 then
        warn("[AutoFarm] Step3 CD not found")
        if items then debugListChildren(items, "Items") end
        disableNoclip()
        return false
    end
    dbg("Step3: Found Items CD = " .. cd3:GetFullName())

    local pos3 = (cd3.Parent and cd3.Parent:IsA("BasePart") and cd3.Parent.Position) or getPositionFromInstance(items)
    if pos3 then
        flyTo(pos3 + Vector3.new(0, 3, 0), CONFIG.FLY_SPEED, 4, 15)
        task.wait(jitter(0.2, 0.4))
    end
    clickCD(cd3)
    task.wait(jitter(0.5, 0.9))

    setStatus("PARTIAL RES ▸ Step 4: Obby PartialObject")
    local pRoot4 = Workspace:WaitForChild("PartialRes", 8)
    local obby   = pRoot4 and pRoot4:WaitForChild("PartialResObby", 8)
    local pObj   = obby and obby:WaitForChild("PartialObject", 12)
    local cd4    = pObj and findFirstClickDetectorIn(pObj)
    local pos4   = pObj and getPositionFromInstance(pObj)
    if not cd4 or not pos4 then
        warn("[AutoFarm] Step4 CD/pos not found")
        if pObj then debugListChildren(pObj, "PartialObject") end
        disableNoclip()
        return false
    end
    dbg("Step4: PartialObject pos = " .. tostring(pos4))

    -- Per-acc XZ offset quanh PartialObject: nhiều acc cùng tween về 1 điểm
    -- y hệt → physics dồn nhau → bị đẩy lên cao + tròng người. Tách mỗi acc
    -- 1 vị trí trên vòng tròn 8 slot quanh object (deterministic theo UserId).
    local SLOT_COUNT  = 8
    local SLOT_RADIUS = 4
    local slotIdx     = ((player.UserId or 0) % SLOT_COUNT)
    local angle       = (slotIdx / SLOT_COUNT) * math.pi * 2
    local slotOffset  = Vector3.new(math.cos(angle) * SLOT_RADIUS, 0, math.sin(angle) * SLOT_RADIUS)
    dbg(string.format("Step4: slot %d/%d → offset (%.1f, 0, %.1f)",
        slotIdx, SLOT_COUNT, slotOffset.X, slotOffset.Z))

    flyTo(pos4 + slotOffset + Vector3.new(0, 5, 0), CONFIG.FLY_SPEED, 4, 15)
    task.wait(0.2)
    stopFlight()

    local _, hrp = waitChar()
    if hrp then
        tweenToCFrame(CFrame.new(pos4 + slotOffset + Vector3.new(0, 2, 0)), 0.8)
    end
    task.wait(jitter(0.15, 0.3))
    clickCD(cd4)

    setStatus("PARTIAL RES ▸ Waiting respawn...")
    local initialChar = player.Character
    local respawned   = false
    local respawnConn = player.CharacterRemoving:Connect(function() respawned = true end)

    local t = 0
    while t < 12 and not respawned do
        task.wait(0.25); t = t + 0.25
        if player.Character and player.Character ~= initialChar then respawned = true end
    end
    if respawnConn then respawnConn:Disconnect() end

    disableNoclip()

    if respawned then
        waitChar()
        task.wait(1.5)
        setStatus("PARTIAL RES ▸ Verifying via Z/X/C...")
        if testHasPartialRes() then
            hasPartialRes = true
            setStatus("PARTIAL RES ✓ VERIFIED")
            dbg("PartialRes verified via Z/X/C reiatsu drop")
            return true
        else
            setStatus("PARTIAL RES ?? RESPAWNED BUT UNVERIFIED")
            warn("[AutoFarm] Respawned but Z/X/C test did not detect reiatsu drop")
            return true
        end
    end
    warn("[AutoFarm] PartialRes — no respawn detected")
    setStatus("PARTIAL RES ✗ FAILED")
    return false
end

local function runRankSevenSequence()
