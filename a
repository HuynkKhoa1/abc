-- Scrape Type Soul codes.
--
-- Architecture (read this before changing anything):
--   1. Session cache (_G.AUTOFARM_CODES_CACHE): first successful fetch in
--      the executor session is reused for every subsequent call — no extra
--      HTTP traffic, no re-scrape risk.
--   2. Network fetch: tries executor `request()` first with a real Chrome
--      User-Agent (bypasses Cloudflare's Roblox-UA filter on pockettactics),
--      falls back to `game:HttpGet`. Iterates multiple sources in case one
--      domain is blocked from this IP.
--   3. Embedded fallback: if every network method fails AND the cache is
--      empty, returns the EMBEDDED_FALLBACK_CODES list so the redeem flow
--      always has *something* to try (avoids the "0 codes → stuck" pit).
--
-- Result: fetchOnlineCodes() NEVER returns empty as long as either the
-- network works once OR the fallback list is non-empty.

-- Hand-curated fallback. Update this list manually when codes rotate
-- (run the standalone snippet, paste the output into this table).
local EMBEDDED_FALLBACK_CODES = {
    "armastorcode",
    "SillyHollow",
    "voidzlatebday",
    "rulesaremadetobebroken",
    "almightycristishowcasev2",
    "kyokanerfsweredeservedlol",
    "texbday",
    "heyitsmevegadodgeframe",
    "arrancarsgettingtheir2ndpartialbackunfortunately",
    "temisburger",
    "TheProdigy",
    "itsalmostthatkindofsummer",
    "NoobSoul",
    "clavgotframemoggedbyasufratleader",
    "EidMubarak",
    "greengiantv",
}

local CODE_SOURCES = {
    "https://www.pockettactics.com/type-soul/codes",
    "https://typesoul.fandom.com/wiki/Codes",
    "https://beebom.com/roblox-type-soul-codes/",
}
local MIN_HTML_BYTES = 15000  -- anything smaller is almost certainly a CF stub

-- Session cache. Persists across redeem cycles within the same script run
-- so we never re-hit the network when we already have a good answer.
_G.AUTOFARM_CODES_CACHE = _G.AUTOFARM_CODES_CACHE or { codes = nil, at = 0, source = nil }

local function httpFetch(url)
    -- Prefer executor request() — sets real UA, bypasses CF Roblox-UA filter.
    local req = (syn and syn.request) or http_request or request
    if req then
        local ok, res = pcall(req, {
            Url     = url,
            Method  = "GET",
            Headers = {
                ["User-Agent"]      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
                ["Accept"]          = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
                ["Accept-Language"] = "en-US,en;q=0.9",
                ["Cache-Control"]   = "no-cache",
                ["Pragma"]          = "no-cache",
            },
        })
        if ok and res then
            local code = tonumber(res.StatusCode or res.Status) or 0
            local body = res.Body or ''
            if code >= 200 and code < 400 and #body > 0 then
                return body, code, 'request'
            end
            return nil, code, 'request'
        end
    end
    -- Fallback: game:HttpGet. Sends Roblox UA — pockettactics often CF-blocks
    -- this, but other domains may still serve it.
    local ok, body = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(body) == "string" then return body, 200, 'HttpGet' end
    return nil, 0, 'HttpGet'
end

-- Extract codes from an HTML body. Returns a fresh table.
local function parseCodesFromHtml(html)
    -- Normalize HTML entities + UTF-8 dash variants → ASCII `-`.
    local norm = html
        :gsub("&#8211;", "-"):gsub("&ndash;", "-"):gsub("&#x2013;", "-")
        :gsub("&#8212;", "-"):gsub("&mdash;", "-"):gsub("&#x2014;", "-")
        :gsub("&hyphen;", "-"):gsub("&minus;", "-")
        :gsub("\226\128\147", "-")  -- UTF-8 en-dash
        :gsub("\226\128\148", "-")  -- UTF-8 em-dash

    local BLACKLIST = {
        type=true, soul=true, codes=true, code=true,
        free=true, reward=true, rewards=true, redeem=true,
        active=true, expired=true, new=true, working=true, valid=true,
        update=true, updated=true, all=true, list=true, latest=true,
        roblox=true, note=true, ['type-soul']=true,
    }

    local codes, seen = {}, {}
    local function addIfValid(code)
        if type(code) ~= 'string' or code == '' then return end
        if #code < 4 or #code > 80 then return end
        if code:find('[^%w_%-]') then return end   -- alphanumeric + _ / - only
        if not code:find('%a') then return end     -- must contain a letter
        local lc = code:lower()
        if BLACKLIST[lc] or seen[lc] then return end
        seen[lc] = true
        table.insert(codes, code)
    end

    -- Pass 1: <strong>code</strong> - Free…   (pockettactics format)
    for code in norm:gmatch("<strong>([%w_%-]+)</strong>%s*%-+%s*[Ff]ree") do
        addIfValid(code)
    end
    -- Pass 2: <strong>code</strong> - <any reward word>
    if #codes == 0 then
        for code in norm:gmatch("<strong>([%w_%-]+)</strong>%s*%-+%s*%a") do
            addIfValid(code)
        end
    end
    -- Pass 3: <b>code</b> - Free…   (alternate tag)
    if #codes == 0 then
        for code in norm:gmatch("<b>([%w_%-]+)</b>%s*%-+%s*[Ff]ree") do
            addIfValid(code)
        end
    end
    -- Pass 4: <code>code</code>   (fandom wiki uses this)
    if #codes == 0 then
        for code in norm:gmatch("<code>([%w_%-]+)</code>") do
            addIfValid(code)
        end
    end
    -- Pass 5 (final fallback): scan ALL <strong>…</strong> spans inside the
    -- active-codes region.
    if #codes == 0 then
        local low = norm:lower()
        local startIdx = low:find('active%s*[%w%s%-]-codes')
            or low:find('working%s*[%w%s%-]-codes')
            or low:find('new%s*[%w%s%-]-codes')
            or 1
        local endIdx = low:find('expired', startIdx + 1) or #norm
        local segment = norm:sub(startIdx, endIdx)
        for code in segment:gmatch("<strong>([%w_%-]+)</strong>") do
            addIfValid(code)
        end
        if #codes == 0 then
            for code in segment:gmatch("<b>([%w_%-]+)</b>") do
                addIfValid(code)
            end
        end
    end

    return codes
end

local function fetchOnlineCodes()
    -- Session cache hit — return instantly, no HTTP at all.
    local cache = _G.AUTOFARM_CODES_CACHE
    if cache and cache.codes and #cache.codes > 0 then
        dbg(string.format("fetchOnlineCodes: cache hit (%d codes from %s, %ds ago)",
            #cache.codes, tostring(cache.source), math.floor(tick() - (cache.at or 0))))
        return cache.codes
    end

    -- Try every source until one returns a real article (>= MIN_HTML_BYTES).
    for _, url in ipairs(CODE_SOURCES) do
        local body, status, via = httpFetch(url)
        local size = body and #body or 0
        if body and size >= MIN_HTML_BYTES then
            local codes = parseCodesFromHtml(body)
            dbg(string.format("fetchOnlineCodes: %s via %s → %dB, parsed %d codes",
                url, via, size, #codes))
            if #codes > 0 then
                -- Cache for the rest of the session
                _G.AUTOFARM_CODES_CACHE = { codes = codes, at = tick(), source = url }
                return codes
            end
            -- Got a big page but couldn't parse codes — keep trying other sources
        else
            dbg(string.format("fetchOnlineCodes: %s via %s → status=%d / %dB (< %dB) → next",
                url, via, status, size, MIN_HTML_BYTES))
        end
    end

    -- Every source failed (CF block, network down, page format drift) →
    -- fall back to the embedded list so the farm doesn't stall.
    warn(string.format("[AutoFarm] fetchOnlineCodes: all %d sources failed — using EMBEDDED_FALLBACK_CODES (%d codes). Update the table in TypeSoul_Source.lua if these go stale.",
        #CODE_SOURCES, #EMBEDDED_FALLBACK_CODES))
    -- Cache the fallback too so we don't re-warn every cycle
    _G.AUTOFARM_CODES_CACHE = { codes = EMBEDDED_FALLBACK_CODES, at = tick(), source = 'embedded_fallback' }
    return EMBEDDED_FALLBACK_CODES
end

-- Merge manual CODES + online fetch, dedupe case-insensitive
local function getAllCodes()
    local manual = flattenCodes(CONFIG.CODES)
    local online = {}
    if CONFIG.AUTO_FETCH_CODES then
        local ok, fetched = pcall(fetchOnlineCodes)
        if ok and type(fetched) == "table" then online = fetched end
    end

    local seen, merged = {}, {}
    for _, c in ipairs(manual) do
        local k = c:lower()
        if not seen[k] then seen[k] = true; table.insert(merged, c) end
    end
    for _, c in ipairs(online) do
        local k = c:lower()
        if not seen[k] then seen[k] = true; table.insert(merged, c) end
    end
    return merged, #manual, #online
end

local function redeemCodes()
    -- Make sure char is settled before firing codes. Right after a
    -- LearnSkill respawn the server briefly rejects Codes invokes — the
    -- waitChar + small idle wait covers that window.
    waitChar(10)
    task.wait(0.5)
    ensureOutOfCombat(5)

    local codes, nManual, nOnline = getAllCodes()
    dbg(string.format("redeemCodes: %d total (%d manual + %d online)", #codes, nManual, nOnline))
    if #codes == 0 then
        dbg("redeemCodes: no codes (manual empty + online fetch failed/empty), skipping")
        return true
    end

    -- Listen for ItemObtained — track whether we received any reroll-related item
    local gotReroll = false
    local lastItem  = nil
    local conn = ClientEffects.OnClientEvent:Connect(function(_, _, payload, itemName, amount)
        if type(payload) ~= "table" then return end
        if payload.Skill == "ItemObtained" then
            local name = tostring(itemName or "")
            lastItem = name
            if name:lower():find("reroll") then
                gotReroll = true
                dbg(string.format("Code redeem: got reroll item → %s x%s", name, tostring(amount or 1)))
            end
        end
    end)

    for attempt = 1, 2 do
        dbg(string.format("=== Redeem attempt %d/2 (%d codes) ===", attempt, #codes))
        for _, code in ipairs(codes) do
            setStatus("CODE : " .. code)
            -- Re-resolve the Codes remote on EVERY invoke. If the character
            -- respawned since the previous code (LearnSkill side-effects,
            -- partial-res respawn, etc.) the prior reference points at an
            -- orphaned remote — server silently drops the invoke and we
            -- get back `false`. Re-fetching guarantees we're talking to the
            -- live character's remote.
            local remote = getCharRemote("Codes")
            local ok, ret = false, nil
            if remote then
                -- Use `:` syntax through a closure so the call is byte-
                -- identical to a manual `remote:InvokeServer(code)` — some
                -- executors hook namecalls in a way that treats
                -- `pcall(remote.InvokeServer, remote, code)` differently.
                ok, ret = pcall(function() return remote:InvokeServer(code) end)
                if not ok then warn("[AutoFarm] InvokeServer failed: " .. tostring(ret)) end
            else
                warn("[AutoFarm] Codes remote missing mid-loop — skipping " .. tostring(code))
            end
            dbg(string.format("  code [%s] (len=%d) → ok=%s ret=%s",
                tostring(code), #tostring(code), tostring(ok), tostring(ret)))
            task.wait(CONFIG.PREP_STEP_DELAY)
            if gotReroll then break end
        end

        -- Grace period for ItemObtained to fire
        local t = 0
        while t < 2 and not gotReroll do
            task.wait(0.2); t = t + 0.2
        end

        if gotReroll then break end
        dbg(string.format("Attempt %d: no reroll item detected (lastItem=%s)", attempt, tostring(lastItem)))
    end

    if conn then pcall(function() conn:Disconnect() end) end

    if not gotReroll then
        -- DO NOT return false here. "No reroll item obtained" after firing
        -- every code is the normal outcome when (a) codes are expired,
        -- (b) all codes were already redeemed in a previous cycle, or
        -- (c) the scraper picked up non-code strings. Returning false makes
        -- doPrep abort and the rank-7 loop hop servers forever (codes are
        -- account-scoped, not server-scoped — hopping doesn't help). The
        -- roll loop has its own bounded failure (ROLL_MAX_ATTEMPTS), so let
        -- it run — it will fail-fast if the inventory truly has no rerolls.
        warn("[AutoFarm] redeemCodes: no NEW reroll obtained — codes likely expired or already redeemed; continuing with existing inventory")
        return true
    end
    return true
end

