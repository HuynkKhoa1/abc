local function learnHakudaStyle()
    setStatus("LEARNING SKILL : Hakuda Style")
    dbg("LearnSkill Hakuda Style (will trigger respawn)")
    local learn = getCharRemote("LearnSkill")
    if not learn then warn("[AutoFarm] LearnSkill remote missing") return false end
    local initialChar = player.Character
    safeFire(learn, "Hakuda Style")

    -- Wait up to 2s for the natural respawn that LearnSkill triggers.
    setStatus("WAITING RESPAWN AFTER LEARN (max 2s)...")
    local respawned = false
    local t = 0
    while t < 2 and not respawned do
        task.wait(0.2); t = t + 0.2
        if player.Character and player.Character ~= initialChar then respawned = true end
    end

    -- Server didn't bounce us — force a reset and wait for the new char.
    if not respawned then
        dbg("Hakuda: no natural respawn in 2s → forcing suicide reset")
        setStatus("HAKUDA NO RESPAWN → RESET")
        suicide()
        local t2 = 0
        while t2 < 10 and not respawned do
            task.wait(0.25); t2 = t2 + 0.25
            if player.Character and player.Character ~= initialChar then respawned = true end
        end
    end

    if not respawned then return false end

    dbg("Character respawning, waiting STABLE...")
    waitChar()
    setStatus("CHARACTER LOADING...")
    task.wait(2.5)
    setStatus("CHARACTER STABLE")
    dbg("Character respawn STABLE")
    return true
end

