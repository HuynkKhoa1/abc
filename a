local function findFirstClickDetectorIn(parent)
    if not parent then return nil end
    if parent:IsA("ClickDetector") then return parent end
    local direct = parent:FindFirstChildOfClass("ClickDetector") or parent:FindFirstChild("ClickDetector")
    if direct then return direct end
    for _, d in ipairs(parent:GetDescendants()) do
        if d:IsA("ClickDetector") then return d end
