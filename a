end

local function flyTo(targetPos, speed, arriveRadius, timeout)
    speed        = speed or CONFIG.FLY_SPEED
    arriveRadius = arriveRadius or 6
    timeout      = timeout or 25

    stopFlight()
    local f = setupFlight()
    if not f then return false end

    local arrived = false
    local conn = RunService.Heartbeat:Connect(function()
        if not f.hrp or not f.hrp.Parent then return end
        local toT = targetPos - f.hrp.Position
        local d = toT.Magnitude
        if d <= arriveRadius then
            f.bv.Velocity = Vector3.zero
            arrived = true
            return
        end
        f.bv.Velocity = toT.Unit * math.min(speed, d * 8)
        local look = Vector3.new(targetPos.X, f.hrp.Position.Y, targetPos.Z)
        f.bg.CFrame = CFrame.lookAt(f.hrp.Position, look)
    end)
    activeFlight = { bv = f.bv, bg = f.bg, hum = f.hum, conn = conn }

    -- Local stuck-detector: nếu position k thay đổi > STUCK_THRESHOLD studs
    -- trong STUCK_TIMEOUT giây = đang kẹt geometry (tường, ledge, terrain).
    -- Burst noclip NOCLIP_BURST giây để xuyên qua, rồi tắt lại (giữ
    -- nguyên trạng thái noclip của caller — nếu caller đã enable từ trước
    -- thì k tắt). Giới hạn MAX_BURSTS lần/fly để k spam.
    local STUCK_THRESHOLD = 2.0
    local STUCK_TIMEOUT   = 1.5
    local NOCLIP_BURST    = 1.0
    local MAX_BURSTS      = 3

    local startT    = tick()
    local lastPos   = f.hrp and f.hrp.Position or Vector3.zero
    local lastMoveT = tick()
    local bursts    = 0
    while not arrived and (tick() - startT) < timeout do
        task.wait(0.1)
        if not f.hrp or not f.hrp.Parent then break end
        local curPos = f.hrp.Position
        if (curPos - lastPos).Magnitude > STUCK_THRESHOLD then
            lastPos   = curPos
            lastMoveT = tick()
        elseif (tick() - lastMoveT) > STUCK_TIMEOUT and bursts < MAX_BURSTS then
            bursts = bursts + 1
            local wasNoclipped = noclipConn ~= nil
            if not wasNoclipped then enableNoclip() end
            dbg(string.format("flyTo: stuck %.1fs at (%.0f,%.0f,%.0f) → noclip burst #%d",
                tick() - lastMoveT, curPos.X, curPos.Y, curPos.Z, bursts))
            local burstUntil = tick() + NOCLIP_BURST
            while tick() < burstUntil and not arrived do
                task.wait(0.1)
                if not f.hrp or not f.hrp.Parent then break end
            end
            if not wasNoclipped then disableNoclip() end
            if f.hrp and f.hrp.Parent then
                lastPos = f.hrp.Position
            end
            lastMoveT = tick()
        end
    end
    stopFlight()
    return arrived
end

local function startHover(height)
    height = height or CONFIG.HOVER_HEIGHT
    local _, hrp, hum = waitChar()
    if not hrp then return function() end end

    local fixedPos = hrp.Position + Vector3.new(0, height, 0)

    stopFlight()

    if hum then
        pcall(function()
            hum.PlatformStand = true
            hum.AutoRotate    = false
