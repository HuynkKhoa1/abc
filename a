local function rollUntilGrimmjow()
    startRollListener()
    local attempts = 0
    while not rolledGrimmjow and attempts < CONFIG.ROLL_MAX_ATTEMPTS do
        attempts = attempts + 1
        rollOnce(attempts)
        local waited = 0
        while waited < CONFIG.ROLL_WAIT_PER_ATTEMPT and not rolledGrimmjow do
            task.wait(0.1); waited = waited + 0.1
        end
    end
    stopRollListener()
    if rolledGrimmjow then
        hasGrimmjow = true
        setStatus("GRIMMJOW ROLLED ✓")
        dbg("Grimmjow obtained after " .. attempts .. " attempts")
        task.wait(0.6)
        return true
    end
    warn("[AutoFarm] Max roll attempts reached without Grimmjow")
    setStatus("ROLL FAILED — MAX ATTEMPTS")
    return false
end

local function doPrepBeforePartialRes()
    dbg("=== Prep before PartialRes ===")
    setStatus("PREP : Ensure out of combat")
    ensureOutOfCombat(10)
    if isInCombat() then
        warn("[AutoFarm] Still in combat after wait, abort prep")
        return false
    end

    addSPHakuda()

    -- Retry learning Hakuda Style up to 3 times if respawn fails
    local function learnHakudaRetry(maxAttempts)
        maxAttempts = maxAttempts or 3
        for attempt = 1, maxAttempts do
            if learnHakudaStyle() then
                return true
            end
            warn(string.format("[AutoFarm] Learn Hakuda attempt %d failed, retrying...", attempt))
            task.wait(1)
        end
        return false
    end
    if not learnHakudaRetry(3) then
        warn("[AutoFarm] Learn Hakuda failed after retries")
        return false
    end

    -- Give another SP after successful respawn to boost stats
    addSPHakuda()

    if not redeemCodes() then return false end
    task.wait(CONFIG.PREP_STEP_DELAY)

    return rollUntilGrimmjow()
end

local function findChildCaseInsensitive(parent, name)
    if not parent then return nil end
    local direct = parent:FindFirstChild(name)
    if direct then return direct end
    local lower = string.lower(name)
    for _, c in ipairs(parent:GetChildren()) do
        if string.lower(c.Name) == lower then return c end
    end
    for _, c in ipairs(parent:GetChildren()) do
        if string.lower(c.Name):find(lower, 1, true) then return c end
    end
    return nil
end

local function waitChildCaseInsensitive(parent, name, timeout)
    timeout = timeout or 5
    local t = 0
    while t < timeout do
        local found = findChildCaseInsensitive(parent, name)
        if found then return found end
        task.wait(0.2); t = t + 0.2
    end
    return nil
end

local function debugListChildren(parent, label)
    if not parent then dbg(label .. ": <nil parent>"); return end
    dbg(label .. " children (" .. parent.Name .. "):")
    for _, c in ipairs(parent:GetChildren()) do
        dbg("  - " .. c.Name .. " (" .. c.ClassName .. ")")
    end
end

