local function preMissionCombatCheck()
    local char = player.Character
    if not char then return true end
    local ct = char:GetAttribute("CombatTag") or 0
    if ct <= 0 then return true end

    local left = char:GetAttribute("CombatTagLeft") or 0
    dbg(string.format("Pre-mission CombatTag = %.1fs", left))

    if left > 15 then
        setStatus(string.format("CT %.0fs > 15s → SUICIDE", left))
        dbg("CombatTag > 15s → suicide + wait respawn")
        stopFlight()
        suicide()
        local oldChar = char
        local t = 0
        while t < 12 do
            task.wait(0.25); t = t + 0.25
            if player.Character and player.Character ~= oldChar then break end
        end
        waitChar()
        task.wait(1.5)
        return false
    end

    if left < 5 then
        setStatus(string.format("CT %.1fs → wait clear", left))
        local t = 0
        while t < 8 do
            task.wait(0.25); t = t + 0.25
            local c = player.Character
            if not c then return false end
            local now = c:GetAttribute("CombatTagLeft") or 0
            if now <= 0 then return true end
            setStatus(string.format("CT %.1fs → wait clear", now))
        end
        return (player.Character:GetAttribute("CombatTagLeft") or 0) <= 0
    end

    setStatus(string.format("CT %.1fs (5-15s) — wait clear", left))
    dbg("CombatTag in 5-15s range, waiting clear")
    local t = 0
    while t < 16 do
        task.wait(0.25); t = t + 0.25
        local c = player.Character
        if not c then return false end
        local now = c:GetAttribute("CombatTagLeft") or 0
        if now <= 0 then return true end
        setStatus(string.format("CT %.1fs — wait clear", now))
    end
    return (player.Character:GetAttribute("CombatTagLeft") or 0) <= 0
end

-- VIM mouse click vô world-space part. Dùng làm fallback khi
-- fireclickdetector silent-fail trên 1 số executor (game wrap CD bằng
-- handler khác, hoặc executor không expose CD API).
--
-- CRITICAL: ClickDetector chỉ fire khi tia raycast từ camera tới part
-- TRÚNG MẶT TRƯỚC. Phải dời camera ra trước part (theo LookVector) rồi
-- mới click — không thì click xuyên mặt sau = CD không nhận.
local function vimClickAtPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
    if not ok or not vim then return false end
    local cam = Workspace.CurrentCamera
    if not cam then return false end

    pcall(function()
        local front = part.CFrame.LookVector
        local camPos = part.Position + front * 10 + Vector3.new(0, 1, 0)
        cam.CFrame = CFrame.lookAt(camPos, part.Position)
    end)
    task.wait(0.15)

    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
    if not onScreen then return false end

    local x, y = screenPos.X, screenPos.Y
    pcall(function()
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.08)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    return true
end

-- Session-level latch: nếu fireclickdetector đã 2 lần fail trên acc này,
-- skip CD luôn ở cycle sau — dùng VIM thẳng (tiết kiệm 4s timeout/cycle).
local _missionClickCDWorks = true

local function acceptOneMission()
    setStatus("TAKING QUEST...")
    dbg("=== Accepting mission ===")

    if not preMissionCombatCheck() then
        dbg("preMissionCombatCheck returned false (suicide path or timeout)")
        return false
    end

    local board, err = findNearestBoard()
    if not board then warn("[AutoFarm] " .. tostring(err)) return false end
    dbg(string.format("Nearest board: %s (%.1f studs)", board.npc.Name, board.dist))

    startCapturingDialogueSession()

    local approach = board.part.Position + Vector3.new(0, 0, 5)
    if not flyTo(approach, CONFIG.FLY_SPEED, 6, 25) then
        warn("[AutoFarm] Fly to board timeout")
        stopCapturingDialogueSession()
        return false
    end
    task.wait(jitter(0.12, 0.22))

    -- Adaptive click strategy:
    --   _missionClickCDWorks=true: attempt 1-2 dùng CD, 3-4 VIM fallback.
    --   Nếu CD fail 2 lần → latch off → cycle sau dùng VIM ngay từ attempt 1.
    local CLICK_ATTEMPTS  = 4
    local PER_TRY_TIMEOUT = 2
    local gotSession      = false
    local cdAttempted     = 0
    local cdSucceeded     = false
    for attempt = 1, CLICK_ATTEMPTS do
        local useCD = _missionClickCDWorks and attempt <= 2
        if useCD then
            cdAttempted = cdAttempted + 1
            dbg(string.format("Click attempt %d/%d: fireclickdetector", attempt, CLICK_ATTEMPTS))
            clickCD(board.cd)
        else
            dbg(string.format("Click attempt %d/%d: VIM mouse click (front-face)", attempt, CLICK_ATTEMPTS))
            vimClickAtPart(board.part)
        end
        if waitForSessionRemote(PER_TRY_TIMEOUT) then
            gotSession = true
            if useCD then cdSucceeded = true end
            break
        end
        warn(string.format("[AutoFarm] No dialogue session after click attempt %d", attempt))
    end

    if _missionClickCDWorks and cdAttempted >= 2 and not cdSucceeded then
        _missionClickCDWorks = false
        warn("[AutoFarm] fireclickdetector failed twice — switching to VIM-only mode for rest of session")
    end

    if not gotSession then
        warn("[AutoFarm] Mission board: all click attempts failed — giving up cycle")
        stopCapturingDialogueSession()
        return false
    end

    task.wait(jitter(0.15, 0.3))
    fireDialogueChoice("Yes")
    stopCapturingDialogueSession()
    return true
end

-- Hop tới server low-pop (sortOrder=Asc) NHƯNG chọn RANDOM trong top 5.
-- Lý do: nếu chọn top 1 (server có ít player nhất), MỌI acc bot đều thấy
-- cùng kết quả → all vô chung 1 server → ban hàng loạt. Random hoá top
-- 5 phân tán traffic mà vẫn giữ low-pop guarantee.
local function hopToServer(lowPopOnly, targetPlaceId)
    local placeId = targetPlaceId or game.PlaceId

    setStatus(lowPopOnly and "HOPPING (LOW-POP)..." or "SERVER HOPPING...")
    dbg("Hopping for PlaceId: " .. placeId .. (lowPopOnly and " (LowPop)" or ""))

    local baseUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    local candidates = {}
    local cursor = nil
    local pages = 0
    local PAGE_LIMIT = 5
    local TARGET_COUNT = 5  -- gom ít nhất 5 server để random

    repeat
        pages = pages + 1
        local url = baseUrl .. ((cursor and "&cursor=" .. cursor) or "")
        local ok, raw = pcall(game.HttpGet, game, url)
        if not ok then
            warn("[AutoFarm] HttpGet failed: " .. tostring(raw))
            break
        end
        local okD, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if not okD or type(decoded) ~= "table" then
            warn("[AutoFarm] JSON decode failed: " .. tostring(decoded))
            break
        end
        if decoded.data then
            for _, s in ipairs(decoded.data) do
                if s.id and s.id ~= game.JobId then
                    if (not lowPopOnly) or (s.playing and s.playing <= (CONFIG.MAX_SERVER_PLAYERS or 10)) then
                        table.insert(candidates, s)
                    end
                end
            end
        end
        cursor = decoded.nextPageCursor
        if #candidates >= TARGET_COUNT then break end
    until not cursor or pages >= PAGE_LIMIT

    local server
    if #candidates > 0 then
        local pickRange = math.min(5, #candidates)
        local idx       = math.random(1, pickRange)
        server          = candidates[idx]
        dbg(string.format("Picked server idx=%d/%d (random 1..%d)", idx, #candidates, pickRange))
    end

    if server then
        setStatus("HOP → " .. tostring(server.id):sub(1, 8) .. " (" .. tostring(server.playing or "?") .. "p)")
        dbg("Hopping to server: " .. tostring(server.id) .. " (" .. tostring(server.playing) .. " players)")
        TeleportService:TeleportToPlaceInstance(placeId, server.id, player)
        task.wait(15)
    else
        warn("[AutoFarm] No suitable server found, rejoining...")
        TeleportService:Teleport(placeId, player)
        task.wait(15)
    end
end

local function isPlayerNearby(range)
    local _, hrp = getChar()
    if not hrp then return false, nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if pHrp and (pHrp.Position - hrp.Position).Magnitude <= range then
                return true, p.Name
            end
        end
    end
    return false, nil
end

local function isServerRaid()
    local ok, val = pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if not assets then return false end
        local sr = assets:FindFirstChild("ServerRaid")
        if not sr then return false end
        return sr.Value == true or sr:GetAttribute("Value") == true
    end)
    return ok and val
end

local function countNearbyShinigami(range)
    local entFolder = Workspace:FindFirstChild("Entities")
    if not entFolder then return 0 end
    local _, hrp = getChar()
    if not hrp then return 0 end
    local count = 0
    for _, npc in ipairs(entFolder:GetChildren()) do
        if npc:IsA("Model") and npc.Name:match("^Shinigami_") then
            local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                or npc:FindFirstChild("Torso")
                or npc.PrimaryPart
            if npcHrp then
                local d = (npcHrp.Position - hrp.Position).Magnitude
                if d <= range then count = count + 1 end
            end
        end
    end
    return count
end

local function runCombatPhase()
    setStatus("WAITING QUEUE...")
    local missionT0   = tick()
    local totalBudget = CONFIG.MISSION_WAIT_TIMEOUT or 20

    local inQ = waitForMissionSignal("InQueue", totalBudget)
    if not inQ then
        setStatus("InQUEUE TIMEOUT — SUICIDE")
        stopFlight()
        suicide()
        task.wait(3.5)
        return false
    end
    setStatus("IN QUEUE — WAITING MISSION...")

    local elapsed   = tick() - missionT0
    local remaining = math.max(1, totalBudget - elapsed)
    local found     = waitForMissionSignal("MissionFound", remaining)

    local shinigamiFallback = false
    if not found then

        local shinCount = countNearbyShinigami(CONFIG.AGGRO_RANGE)
        if shinCount >= 2 then
            shinigamiFallback = true
            dbg(string.format("MissionFound timeout but %d shinigami nearby → engage immediately", shinCount))
            setStatus(string.format("NO SIGNAL BUT %d SHINIGAMI → FARMING", shinCount))
        else
            setStatus(string.format("MISSION TIMEOUT >%ds — SUICIDE", totalBudget))
            stopFlight()
            suicide()
            task.wait(3.5)
            return false
        end
    end

    if found then
        local mInfo       = found.missionData and found.missionData.MissionInfo
        local missionName = (mInfo and mInfo.MissionName) or "?"
        setStatus("QUEST FOUND : " .. missionName)
        dbg(string.format("Mission found: %s | Reward: %s Kan, %s EXP",
            missionName,
            mInfo and mInfo.Reward and mInfo.Reward.Kan or "?",
            mInfo and mInfo.Reward and mInfo.Reward.EXP or "?"))

        if missionName:lower():find("forest") then
            setStatus("FOREST DETECTED — SUICIDE + RESTART")
            stopFlight()
            suicide()
            task.wait(3.5)
            return true
        end
    end

    if not shinigamiFallback then
        task.wait(jitter(0.6, 1.0))
    end

    local idleScans           = 0
    local combatStartT        = tick()
    local heavyTagStartT      = nil
    local dealtDamage         = false
    local allKnockedOutSince  = nil

    while not farmStop do

        if not dealtDamage and (tick() - combatStartT) > 10 then
            setStatus("NO DAMAGE IN 10s — SUICIDE")
            dbg("No damage dealt to any target within 10s, suicide")
            stopFlight()
            suicide()
            task.wait(3.5)
            return false
        end

        local char = player.Character
        local tagOwner = char and char:GetAttribute("CombatTagOwner")
        local tagOwnerStr = tagOwner and tostring(tagOwner) or ""

        -- REAL PLAYER hit → suicide NGAY, không đợi heavy-hostile-timeout.
        -- Player có thể combo chết trước; reset clean qua suicide thay vì
        -- chết tự nhiên (server thấy death-by-player → bot pattern flag).
        if tagOwnerStr ~= "" and Players:FindFirstChild(tagOwnerStr) then
            setStatus("REAL PLAYER HIT: " .. tagOwnerStr .. " → SUICIDE")
            dbg("Tagged by real player " .. tagOwnerStr .. " — instant suicide reset")
            stopFlight(); suicide(); task.wait(3.5)
            return true
        end

        if tagOwner and isHeavyHostileName(tagOwnerStr) then
            heavyTagStartT = heavyTagStartT or tick()
            if tick() - heavyTagStartT > CONFIG.HEAVY_HOSTILE_TIMEOUT then
                setStatus("HEAVY HOSTILE >" .. CONFIG.HEAVY_HOSTILE_TIMEOUT .. "s — SUICIDE")
                dbg("Heavy hostile tag persisted > " .. CONFIG.HEAVY_HOSTILE_TIMEOUT .. "s, suicide")
                stopFlight(); suicide(); task.wait(3.5)
                return true
            end
        else
            heavyTagStartT = nil
        end

        local targets = scanTargets()
        if #targets > 0 then
            idleScans = 0
            dealtDamage = true
            allKnockedOutSince = nil
            attackTarget(targets[1])
            task.wait(jitter(0.08, 0.18))
        else
            local gripT = findGripTarget()
            if gripT then
                idleScans = 0
                dealtDamage = true
                allKnockedOutSince = nil
                gripTarget(gripT)
                task.wait(CONFIG.GRIP_INTERVAL + jitter(0, 0.15))
            else

                local unconsciousCount = 0
                local entFolder = Workspace:FindFirstChild("Entities")
                if entFolder then
                    local _, hrp = getChar()
                    if hrp then
                        for _, npc in ipairs(entFolder:GetChildren()) do
                            if npc:IsA("Model") and npc.Name:match("^Shinigami_")
                                and npc:GetAttribute("CurrentState") == "Unconscious" then
                                local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                                    or npc:FindFirstChild("Torso") or npc.PrimaryPart
                                if npcHrp and (npcHrp.Position - hrp.Position).Magnitude <= CONFIG.AGGRO_RANGE then
                                    unconsciousCount = unconsciousCount + 1
                                end
                            end
                        end
                    end
                end

                if unconsciousCount >= 2 then
                    allKnockedOutSince = allKnockedOutSince or tick()
                    local stuckTime = tick() - allKnockedOutSince
                    setStatus(string.format("BOTH KO BUT NO GRIP (%.1fs/10s)", stuckTime))
                    if stuckTime > 10 then
                        setStatus("GRIP BLOCKED 10s — SUICIDE")
                        dbg("Both shinigami unconscious but grip failed for 10s, likely interfered — suicide")
                        stopFlight()
                        suicide()
                        task.wait(3.5)
                        return false
                    end
                    task.wait(0.25)
                else
                    allKnockedOutSince = nil
                    idleScans = idleScans + 1
                    if idleScans >= 4 then break end
                    task.wait(0.25)
                end
            end
        end
    end

    local char = player.Character
    if char then
        local ct    = char:GetAttribute("CombatTag") or 0
        local owner = char:GetAttribute("CombatTagOwner")
        if ct > 0 and owner and tostring(owner) ~= "" then
            local ownerStr        = tostring(owner)
            local rule            = getEntityRule(ownerStr)
            local isHeavy         = rule and rule.heavy
            local isAnotherPlayer = Players:FindFirstChild(ownerStr) ~= nil

            if isHeavy or isAnotherPlayer then
                local left = char:GetAttribute("CombatTagLeft") or 0
                dbg(string.format("Combat tag from %s (%s), left=%.1fs",
                    ownerStr, isHeavy and rule.kind or "player", left))
                if left > 5 then
                    setStatus("HEAVY TAG : " .. ownerStr .. " | SUICIDE")
                    stopFlight()
                    suicide()
                    task.wait(3.5)
                else
                    local t = 0
                    while t < 8 and (char.Parent and (char:GetAttribute("CombatTagLeft") or 0) > 0) do
                        task.wait(0.25); t = t + 0.25
                        setStatus(string.format("WAITING TAG : %s (%.1fs)",
                            ownerStr, char:GetAttribute("CombatTagLeft") or 0))
                    end
                end
            else
                setStatus("KILLING TAGGER : " .. ownerStr)
                dbg("Tagger is killable mob: " .. ownerStr)
                local entFolder = Workspace:FindFirstChild("Entities")
                local entity    = entFolder and entFolder:FindFirstChild(ownerStr)
                if entity then
                    local eHrp = entity:FindFirstChild("HumanoidRootPart")
                        or entity:FindFirstChild("Torso")
                        or entity.PrimaryPart
                    if eHrp then
                        local taggerRule = getEntityRule(entity.Name)
                        attackTarget({ npc = entity, hrp = eHrp, dist = 0, rule = taggerRule })
                        task.wait(jitter(0.2, 0.4))
                        if entity.Parent and entity:GetAttribute("CurrentState") == "Unconscious" then
                            gripTarget({ npc = entity, hrp = eHrp, dist = 0 })
                            task.wait(CONFIG.GRIP_INTERVAL)
                        end
                    end
                end
            end
        end
    end

    setStatus("Idle")
    return true
end

local function runOneCycle()
    if not acceptOneMission() then return false end
    return runCombatPhase()
end

