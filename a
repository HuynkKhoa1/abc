local lockedHorizFwd = nil
local function faceDownCFrame(myPos, tgtPos)
    if not lockedHorizFwd then
        local h = Vector3.new(tgtPos.X - myPos.X, 0, tgtPos.Z - myPos.Z)
        lockedHorizFwd = h.Magnitude > 0.05 and h.Unit or Vector3.new(0, 0, -1)
    end
    local yawCF = CFrame.lookAt(myPos, myPos + lockedHorizFwd)
    return yawCF * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function attackTarget(target)
    if not target or not target.npc.Parent then return false end

    setStatus("TARGETING : " .. target.npc.Name)
    dbg("attackTarget: " .. target.npc.Name .. " dist=" .. string.format("%.1f", target.dist or 0))
    ensureWeaponDrawn()

    local _, hrp = waitChar()
    if not hrp then return false end

    lockedHorizFwd = nil
    stopFlight()
    local f = setupFlight()
    if not f then return false end

    local hoverH = (target.rule and target.rule.hoverHeight) or getHoverHeight()
    dbg("hover height: " .. hoverH)

    local stop = false
    local conn = RunService.Heartbeat:Connect(function()
        if stop or not f.hrp or not f.hrp.Parent then return end
        if not target.npc.Parent or not target.hrp.Parent then stop = true; return end

        local tgtPos   = target.hrp.Position
        local tgtVel   = target.hrp.AssemblyLinearVelocity or Vector3.zero
        local tgtHoriz = Vector3.new(tgtVel.X, 0, tgtVel.Z)
        local hoverPos = tgtPos + Vector3.new(0, hoverH, 0) + tgtHoriz * 0.12
        local toHover  = hoverPos - f.hrp.Position
        local d        = toHover.Magnitude

        if d > 0.2 then
            local correction = toHover.Unit * math.min(CONFIG.HOVER_SPEED, d * 18)
            f.bv.Velocity = correction + tgtHoriz
        else
            f.bv.Velocity = tgtHoriz
        end

        local desired = faceDownCFrame(f.hrp.Position, tgtPos)
        f.bg.CFrame   = desired
        local rot = desired - desired.Position
        pcall(function()
            f.hrp.CFrame = CFrame.new(f.hrp.Position) * rot
        end)
    end)
    activeFlight = { bv = f.bv, bg = f.bg, hum = f.hum, conn = conn }

    local approachT = 0
    while approachT < 1.5 do
        task.wait(0.05); approachT = approachT + 0.05
        if not target.hrp.Parent then stop = true; break end
        local hoverPos = target.hrp.Position + Vector3.new(0, hoverH, 0)
        if (f.hrp.Position - hoverPos).Magnitude <= 6 then break end
    end

    local startT = os.clock()
    local result = false
    local lastCritT = 0
    local critInterval = jitter(CONFIG.CRIT_INTERVAL_MIN, CONFIG.CRIT_INTERVAL_MAX)
    local lastSkillT = 0
    local skillInterval = jitter(CONFIG.SKILL_INTERVAL_MIN, CONFIG.SKILL_INTERVAL_MAX)
    local skillRotIdx = 1
    while os.clock() - startT < CONFIG.KILL_TIMEOUT do
        if not target.npc.Parent or not target.hrp.Parent then break end
        local state = target.npc:GetAttribute("CurrentState")
        if state == "Unconscious" then result = true; break end
        local hum = target.npc:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then result = true; break end

        if tick() - lastCritT >= critInterval then
            fireCrit()
            lastCritT    = tick()
            critInterval = jitter(CONFIG.CRIT_INTERVAL_MIN, CONFIG.CRIT_INTERVAL_MAX)
        end

        if #AUTO_SKILL_SLOTS > 0 and tick() - lastSkillT >= skillInterval then
            local slot = AUTO_SKILL_SLOTS[skillRotIdx]
            fireSkill(slot)
            skillRotIdx   = (skillRotIdx % #AUTO_SKILL_SLOTS) + 1
            lastSkillT    = tick()
            skillInterval = jitter(CONFIG.SKILL_INTERVAL_MIN, CONFIG.SKILL_INTERVAL_MAX)
        end

        fireM1()
        task.wait(jitter(CONFIG.M1_INTERVAL_MIN, CONFIG.M1_INTERVAL_MAX))
    end

    stop = true
    stopFlight()
    return result
end

